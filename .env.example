# Vercel Environment Variables for Gita4Youth Firebase Firestore Integration
# Add these in Vercel Dashboard → Project → Settings → Environment Variables

VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_PROJECT_ID=gita4youth-25579
VITE_FIREBASE_AUTH_DOMAIN=gita4youth-25579.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=gita4youth-25579.appspot.com
